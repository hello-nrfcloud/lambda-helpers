{
  "name": "@hello.nrfcloud.com/lambda-helpers",
  "version": "0.0.0-development",
  "description": "Helper functions for AWS lambdas written in TypeScript.",
  "exports": {
    "./*": {
      "import": {
        "types": "./npm/*.d.ts",
        "default": "./npm/*.js"
      }
    }
  },
  "type": "module",
  "scripts": {
    "test": "tsx --no-warnings --test ./src/*.spec.ts",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "prepublishOnly": "node --experimental-strip-types ./.npm/compile.ts && npx tsc -P ./.npm/tsconfig.npm.json --outDir ./npm && mv ./npm/src/* ./npm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-nrfcloud/lambda-helpers.git"
  },
  "bugs": {
    "url": "https://github.com/hello-nrfcloud/lambda-helpers/issues"
  },
  "homepage": "https://github.com/hello-nrfcloud/lambda-helpers",
  "keywords": [
    "aws",
    "lambda",
    "typescript"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@bifravst/eslint-config-typescript": "6.4.4",
    "@bifravst/prettier-config": "1.1.17",
    "@commitlint/config-conventional": "20.5.3",
    "@swc/core": "1.15.33",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "25.9.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "check-node-version": "4.2.1",
    "commitlint": "20.5.3",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "tsx": "4.23.10"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22",
    "npm": ">=12.0.2 <13"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "npm",
    "LICENSE",
    "README.md"
  ],
  "prettier": "@bifravst/prettier-config",
  "peerDependencies": {
    "@aws-lambda-powertools/metrics": "^2.33.1",
    "@aws/durable-execution-sdk-js": "^1.1.7",
    "@hello.nrfcloud.com/proto": "^15.4.93",
    "@middy/core": "^7.1.2",
    "@middy/input-output-logger": "^7.1.2"
  }
}
